{
  "name": "dsh-sidebar-launcher",
  "version": "0.1.0",
  "description": "A draggable square launcher over the DSH Web shell that opens the right Sidebar's tab guide, with the last three tabs you activated kept on top.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@shikijs/langs": "^4.5.0",
    "@types/node": "^26.6.4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.34.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
